# ── AniList ───────────────────────────────────────────────
ANILIST_USERNAME=cosmicswordfish

# ── MyAnimeList OAuth ─────────────────────────────────────
# Create your app at: https://myanimelist.net/apiconfig
# App Type:      web
# Redirect URI:  http://localhost:5000/mal/callback  (or your public domain)
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
MAL_REDIRECT_URI=http://localhost:5000/mal/callback

# ── Flask ─────────────────────────────────────────────────
# REQUIRED: generate once with:  python -c "import secrets; print(secrets.token_hex(32))"
# Without this, every app restart regenerates the key, invalidating all sessions.
# This is the #1 cause of MAL OAuth looping — the PKCE verifier is stored in
# the session between /mal/login and /mal/callback, and is lost if the key changes.
SECRET_KEY=change_this_to_a_random_secret_key

# ── For hosting (Railway / Render / VPS) ─────────────────
# Set MAL_REDIRECT_URI to your public domain, e.g:
# MAL_REDIRECT_URI=https://yourdomain.com/mal/callback
# HTTPS=true   ← uncomment this when running behind HTTPS
